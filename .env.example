# PharmConnect Zim — frontend environment
#
# The browser holds no database credentials. Everything goes through the
# API server, which is the only thing that talks to Postgres.

# --- API ---
VITE_API_URL=http://localhost:4000

# --- Google Maps (browser) ---
# The Maps JavaScript SDK renders maps in the page, so this key is public
# and cannot be proxied. Restrict it by HTTP referrer and scope it to ONLY
# "Maps JavaScript API".
#
# Geocoding, autocomplete and distance lookups go through /api/maps/*
# instead, using the separate server-side key in server/.env. Keep the two
# distinct — sharing one key makes the referrer restriction pointless.
VITE_GOOGLE_MAPS_API_KEY=
