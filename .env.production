# Default API URL for production builds.
#
# Not a secret — it is a public hostname and ends up in the shipped bundle
# either way. Committed so a build can never silently have no API URL.
#
# A VITE_API_URL set in the hosting platform takes precedence over this
# file, so staging/preview environments can still point elsewhere.
VITE_API_URL=https://pharmconnect-api.onrender.com
