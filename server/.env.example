# ---- Database (Neon) ----
# Pooled connection string from the Neon console. The -pooler host is the
# right one for a web server; the direct host is for migrations and psql.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# ---- Auth ----
# Used to derive the password pepper. Rotating this invalidates every
# stored password, so set it once and keep it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

SESSION_TTL_DAYS=30

# ---- HTTP ----
PORT=4000
NODE_ENV=development

# Origins allowed to call the API with a session cookie. Comma-separated.
CORS_ORIGINS=http://localhost:8080

# Where the browser is sent after Google OAuth completes.
APP_URL=http://localhost:8080

# Only enable behind a proxy that sets X-Forwarded-For. Enabling it on a
# directly-exposed server lets callers spoof their IP past the rate limiter.
TRUST_PROXY=false

# ---- Google OAuth (optional) ----
# Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---- Google Maps (optional) ----
# Server-side only. Do not expose this to the browser.
GOOGLE_MAPS_API_KEY=

# ---- Rate limiting ----
# Ceiling on Google-billed map lookups per hour across every caller. The
# per-caller limit does nothing about many callers, and the bill does not
# care how the traffic was spread. Defaults to 1000.
MAPS_HOURLY_BUDGET=1000

# Turns off the public rate limits. For local work and for running
# test/smoke.sh, which registers several accounts from one address in a
# few seconds. Honoured only when NODE_ENV is not "production", so setting
# it on a live deploy cannot quietly remove the limits.
RATE_LIMIT_DISABLED=false

# Direct (non-pooled) connection, used only by the SSE listener because
# LISTEN/NOTIFY cannot work through PgBouncer transaction pooling.
# Defaults to DATABASE_URL with "-pooler" removed.
DATABASE_URL_UNPOOLED=

# ---- Email (SMTP) ----
# Plain SMTP, so any provider works: Gmail with an app password, Zoho,
# Brevo, Mailgun, SES, Postmark, or a local relay.
#
# Without this, password reset and invitations cannot be delivered — the
# server warns loudly at boot and writes messages to the console instead.
#
# Port 465 is implicit TLS; 587 starts plaintext and upgrades via STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Set true only for port 465. Otherwise STARTTLS is negotiated automatically.
SMTP_SECURE=false

# Envelope sender. Most providers reject a From that does not match the
# authenticated account, so this defaults to SMTP_USER.
EMAIL_FROM=
EMAIL_FROM_NAME=PharmConnect Zim

# Where new-pharmacy alerts go. Comma-separated. Leave blank to notify
# every active super admin instead, resolved at send time.
ADMIN_ALERT_EMAIL=
