# The PharmConnect API this agent pushes to.
API_URL=http://localhost:4000

# A dedicated pharmacy_admin account for this agent. It authenticates like
# any other user, so it can only touch its own pharmacy — unlike the
# Supabase service-role key this replaced, which bypassed every rule in the
# system from a PC sitting on a pharmacy counter.
#
# Do not enable two-factor auth on this account: an unattended agent cannot
# answer a TOTP prompt.
AGENT_EMAIL=
AGENT_PASSWORD=

PHARMACY_ID=uuid-of-the-pharmacy
LOCAL_DB_PATH=./mock_pos.db
POLL_INTERVAL_MS=60000
